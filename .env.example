# Copy to .env (git-ignored) next to docker-compose.yml and fill in.

# central-api signs its own auth tokens with this — any long random string,
# generate once per environment and never reuse across environments.
CENTRAL_API_JWT_SECRET=

# Shared secret between instructor-api and central-api. central-api refuses
# every request without it, so the AI service can only be used through the
# portal. Generate with: openssl rand -hex 32
CENTRAL_API_SERVICE_TOKEN=

# Optional: AI-drafted questions (from uploaded study material) need this.
# Without it, everything else works — past-paper-only exams, freezing,
# packaging, the kiosk — just not AI drafting.
ANTHROPIC_API_KEY=

# true once instructor-web is actually served over HTTPS (a reverse proxy
# terminating TLS in front of it). Leave false for plain-HTTP testing —
# a true value here on plain HTTP means the session cookie never gets sent
# and nobody can stay signed in.
COOKIE_SECURE=false

# Only needed to bring up the `local-exam-server` service (profile "venue"),
# once a real paper has been frozen and packaged from the portal.
CBT_EXAM_ID=
CBT_CENTRE_NAME=Exam centre
# Pause a candidate's exam after this many integrity warnings (0 = never).
CBT_LOCK_AFTER=5
# Safe Exam Browser keys from the SEB Config Tool (comma-separated). Setting
# either makes SEB mandatory for the kiosk; leave both empty to allow any browser.
CBT_SEB_CONFIG_KEYS=
CBT_SEB_BROWSER_EXAM_KEYS=

# Theory marking models (all local, via Ollama). Defaults shown.
# MARKING_MODEL=qwen3:4b
# DEEP_MARKING_MODEL=deepseek-r1
# OCR_MODEL=qwen2.5vl:3b
# OCR_MAX_PX=1000
