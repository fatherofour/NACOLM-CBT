// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  OBJECTIVE
  THEORY
}

enum QuestionSource {
  PAST_PAPER
  AI_DRAFTED
}

enum QuestionStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum DocumentType {
  PAST_PAPER
  STUDY_MATERIAL
}

enum UserRole {
  INSTRUCTOR
  EXAM_OFFICER
  ADMIN
}

// Pipeline state for one pen-and-paper theory answer, from upload through to
// a published result. AI_MARKING_FAILED and OCR_FAILED are terminal until
// the instructor re-runs that step — they never silently fall through to a
// score.
enum ScriptAnswerStatus {
  UPLOADED
  OCR_FAILED
  AI_MARKING_FAILED
  PENDING_REVIEW
  REVIEWED
  PUBLISHED
}

// Portal users. Passwords are scrypt hashes (see src/auth/password.ts);
// accounts are created with scripts/create-user.mjs, not self-registration.
model User {
  id            String        @id @default(cuid())
  // Sign-in identifier. Separate from serviceNumber (their real Army
  // service number, kept for identity/audit — see decorators.ts's
  // actorName) because a service number is public/guessable and this
  // isn't meant to double as a secret-adjacent login credential.
  username      String        @unique
  serviceNumber String        @unique
  rank          String
  fullName      String
  role          UserRole      @default(INSTRUCTOR)
  passwordHash  String
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  sessions      AuthSession[]
}

// Server-side login sessions. The browser only holds a random token in an
// httpOnly cookie; we store its SHA-256, so revoking a row (logout, account
// disabled) ends that session immediately.
model AuthSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  @@index([userId])
}

model Course {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Session {
  id         String             @id @default(cuid())
  course     Course             @relation(fields: [courseId], references: [id])
  courseId   String
  label      String // e.g. "2024/2025"
  documents  SourceDocument[]
  questions  QuestionBankItem[]
  blueprints Blueprint[]
  papers     Paper[]
  candidates Candidate[]
  createdAt  DateTime           @default(now())

  @@unique([courseId, label])
}

model SourceDocument {
  id                   String       @id @default(cuid())
  session              Session      @relation(fields: [sessionId], references: [id])
  sessionId            String
  title                String
  docType              DocumentType
  storagePath          String
  // Set once this document has also been registered + ingested with the
  // central-api RAG service, which is what actually does the AI drafting —
  // see AiGenerationService. Null until that hand-off succeeds.
  centralApiDocumentId String?
  uploadedAt           DateTime     @default(now())
}

model QuestionBankItem {
  id              String         @id @default(cuid())
  session         Session        @relation(fields: [sessionId], references: [id])
  sessionId       String
  topic           String
  difficulty      String         @default("medium")
  type            QuestionType
  source          QuestionSource
  status          QuestionStatus @default(DRAFT)
  body            String
  options         Json? // OBJECTIVE only: string[]
  correctIndex    Int? // OBJECTIVE only
  // AI-drafted provenance, so the instructor can verify grounding without
  // re-reading the whole source document (spec: "citation chip").
  citation        String?
  citationExcerpt String?
  rejectReason    String?
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  markingScheme MarkingScheme?
  approvalLogs  ApprovalLog[]
  paperItems    PaperItem[]
  scriptAnswers TheoryScriptAnswer[]
}

model MarkingScheme {
  id             String           @id @default(cuid())
  question       QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId     String           @unique
  totalMarks     Int
  ceilingPercent Int              @default(50) // score cap if a required group is missing
  minWordCount   Int              @default(15)
  reusedFromBank Boolean          @default(false)
  conceptGroups  ConceptGroup[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ConceptGroup {
  id            String        @id @default(cuid())
  scheme        MarkingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  schemeId      String
  canonicalTerm String
  synonyms      String[] // additional acceptable terms, on top of canonicalTerm
  marks         Int
  required      Boolean       @default(false)
  order         Int           @default(0)
}

model Blueprint {
  id                String   @id @default(cuid())
  session           Session  @relation(fields: [sessionId], references: [id])
  sessionId         String
  targetCount       Int
  objectiveCount    Int
  theoryCount       Int
  sourceMode        String // "past_only" | "study_material_only" | "both"
  pastQuestionRatio Float    @default(1.0) // only meaningful for "both"
  distribution      Json? // target counts by topic/difficulty, e.g. {"OSI Model":{"medium":5,"hard":2}}
  // Past-paper sessions ("years") the instructor chose to draw bank questions from.
  pastSessionIds    String[] @default([])
  // Instructor's difficulty split, e.g. {"easy":18,"medium":30,"hard":12}; sums to targetCount.
  difficultyTargets Json?
  // "instant": candidates see results on submission; "hold": results go to the instructor first.
  resultsRelease    String   @default("hold")
  createdAt         DateTime @default(now())
}

model Paper {
  id              String         @id @default(cuid())
  session         Session        @relation(fields: [sessionId], references: [id])
  sessionId       String
  title           String
  durationMinutes Int            @default(60)
  passMark        Float          @default(50)
  versions        PaperVersion[]
  createdAt       DateTime       @default(now())
}

model PaperVersion {
  id            String       @id @default(cuid())
  paper         Paper        @relation(fields: [paperId], references: [id])
  paperId       String
  versionNumber Int
  // The exam's planned date. Informational only — it doesn't control when
  // candidates can actually sit the exam; that's still the invigilator
  // releasing it at the venue (local-exam-server runs fully offline and has
  // no connection back to this portal's clock).
  examDate      DateTime
  publishedAt   DateTime     @default(now())
  publishedBy   String // actorName(user) — rank, full name and service number
  signatureHash String // sha256 of the published item set, so tampering after publishing is detectable
  items         PaperItem[]
  examPackage   ExamPackage?
  scriptAnswers TheoryScriptAnswer[]

  @@unique([paperId, versionNumber])
}

model PaperItem {
  id             String           @id @default(cuid())
  paperVersion   PaperVersion     @relation(fields: [paperVersionId], references: [id])
  paperVersionId String
  question       QuestionBankItem @relation(fields: [questionId], references: [id])
  questionId     String
  position       Int
}

// The candidate roster for a session — who's registered to sit its exams.
// Bundled into the encrypted package at "Package for exam centre" time so
// the offline local-exam-server can verify check-in (Army Number + PIN)
// without ever contacting this service. pinHash uses the same scrypt format
// as User.passwordHash (see src/auth/password.ts) — the PIN itself is never
// stored and is only ever returned once, at creation or reset.
model Candidate {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id])
  sessionId  String
  armyNumber String
  rank       String
  fullName   String
  pinHash    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  scriptAnswers TheoryScriptAnswer[]

  @@unique([sessionId, armyNumber])
}

// One row per successful "Package for exam centre" call. The release key
// itself is deliberately not stored here — see central-api's crypto.py for
// why — it's returned once in the API response, same as build-package does
// on the central-api side directly.
model ExamPackage {
  id             String       @id @default(cuid())
  paperVersion   PaperVersion @relation(fields: [paperVersionId], references: [id])
  paperVersionId String       @unique
  storagePath    String
  checksumSha256 String
  poolSize       Int
  builtAt        DateTime     @default(now())
  builtBy        String
}

// A pen-and-paper theory answer: the instructor's exam is written on paper,
// scanned, and uploaded here per candidate per question. A local model reads
// the handwriting (OCR) and then marks it against the question's
// MarkingScheme/ConceptGroups the same way the CBT keyword engine would, but
// judging paraphrase rather than exact keyword hits — see
// theory-scripts/ollama.service.ts for why this runs against a local Ollama
// model rather than a paid API during this testing phase. The AI's score is
// never final: it always lands in PENDING_REVIEW with its justification
// attached, and only an instructor's explicit review moves it to REVIEWED,
// then PUBLISHED. instructorScore is null until reviewed, even if the
// instructor agrees with the AI number verbatim — that keeps "reviewed" and
// "not yet looked at" unambiguous in the data, not just in the status field.
model TheoryScriptAnswer {
  id             String       @id @default(cuid())
  paperVersion   PaperVersion @relation(fields: [paperVersionId], references: [id])
  paperVersionId String
  candidate      Candidate    @relation(fields: [candidateId], references: [id])
  candidateId    String
  question       QuestionBankItem @relation(fields: [questionId], references: [id])
  questionId     String

  imagePath       String // uploaded scan of this candidate's answer to this question
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  transcribedText String? // OCR output
  ocrModel        String?
  ocrError        String?

  aiScore         Float?
  aiMaxScore      Float?
  aiJustification String?
  aiModel         String?
  aiError         String?

  instructorScore Float?
  instructorNotes String?
  reviewedBy      String?
  reviewedAt      DateTime?

  status    ScriptAnswerStatus @default(UPLOADED)
  updatedAt DateTime           @updatedAt

  @@unique([paperVersionId, candidateId, questionId])
}

// Every mutating action on a question (approve / edit / reject) writes one of
// these — what makes a paper defensible if challenged later. `actor` is free
// text for now (e.g. "instructor-demo") since real session auth is a
// follow-up, not this pass — see instructor-api/README.md.
model ApprovalLog {
  id          String           @id @default(cuid())
  question    QuestionBankItem @relation(fields: [questionId], references: [id])
  questionId  String
  action      String // "approve" | "edit" | "reject"
  actor       String
  reason      String? // required for "reject"
  beforeState Json?
  afterState  Json?
  createdAt   DateTime         @default(now())
}
