</mxCell><mxCell id="c20" parent="1" edge="1" source="D1" target="D2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="D3" parent="1" vertex="1" value="Publish confirmed results" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e8ebe4;strokeColor=#6b7563;fontColor=#1d2318;align=left;spacingLeft=40;spacingRight=6;"><mxGeometry x="740" y="660" width="196" height="76" as="geometry"/></mxCell><mxCell id="D3_i" parent="D3" vertex="1" value="" style="shape=image;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;image=data:image/svg+xml,;"><mxGeometry x="10" y="25.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="D4" parent="1" vertex="1" value="Ask the instructor to finish reviewing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e8ebe4;strokeColor=#6b7563;fontColor=#1d2318;align=left;spacingLeft=40;spacingRight=6;"><mxGeometry x="1000" y="660" width="196" height="76" as="geometry"/></mxCell><mxCell id="D4_i" parent="D4" vertex="1" value="" style="shape=image;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;image=data:image/svg+xml,;"><mxGeometry x="10" y="25.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="c21" parent="1" edge="1" source="D2" target="D3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="630"/><mxPoint x="838" y="630"/></Array></mxGeometry></mxCell><mxCell id="c22" parent="1" edge="1" source="D2" target="D4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="630"/><mxPoint x="1098" y="630"/></Array></mxGeometry></mxCell><mxCell id="c23" parent="1" edge="1" source="D4" target="D2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1236" y="698"/><mxPoint x="1236" y="542"/></Array></mxGeometry></mxCell><mxCell id="c24" parent="1" vertex="1" value="Admins set up, instructors run exams. Only admins can create accounts and courses; publishing a paper and building the exam package stay with the exam officer.&lt;br&gt;An admin can publish results, but only once every script has been confirmed by a person." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontColor=#3a3f35;"><mxGeometry x="60" y="740" width="620" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="roles" name="Who can do what"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" parent="1" vertex="1" value="Who can do what" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontStyle=1;"><mxGeometry x="60" y="16" width="800" height="34" as="geometry"/></mxCell><mxCell id="c2" parent="1" vertex="1" value='&lt;table style="border-collapse:collapse;font-size:13px;width:100%"&gt;&lt;tr&gt;&lt;th style="padding:6px 10px;text-align:left;background:#e8ebe4;border-bottom:1px solid #6b7563"&gt;Action&lt;/th&gt;&lt;th style="padding:6px 10px;text-align:left;background:#e8ebe4;border-bottom:1px solid #6b7563"&gt;Instructor&lt;/th&gt;&lt;th style="padding:6px 10px;text-align:left;background:#e8ebe4;border-bottom:1px solid #6b7563"&gt;Exam officer&lt;/th&gt;&lt;th style="padding:6px 10px;text-align:left;background:#e8ebe4;border-bottom:1px solid #6b7563"&gt;Admin&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Upload documents, set blueprint, review questions&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Add candidates and reset PINs&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Upload scans, review and confirm theory marks&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Publish confirmed theory results&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Publish the exam paper and build the package&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Create courses and sessions&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:6px 10px;border-bottom:1px solid #d9ddd3"&gt;Create and manage user accounts&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;td style="padding:6px 10px;color:#8a9184;text-align:center"&gt;No&lt;/td&gt;&lt;td style="padding:6px 10px;color:#4a5d3a;font-weight:bold;text-align:center"&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;verticalAlign=top;overflow=fill;rounded=0;"><mxGeometry x="60" y="70" width="820" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>